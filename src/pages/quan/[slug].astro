---
import Layout from '../../layouts/Layout.astro';
import FoodImage from '../../components/FoodImage.astro';
import Provenance from '../../components/Provenance.astro';
import {restaurants,dishes,mapsSearchUrl} from '../../data/catalog.mjs';
export function getStaticPaths(){return restaurants.map(restaurant=>({params:{slug:restaurant.slug},props:{restaurant}}));}
const {restaurant}=Astro.props;
const dish=dishes.find(d=>d.slug===restaurant.dish)!;
---
<Layout title={`${restaurant.name} — Thông tin địa chỉ`} image={dish.image}><div class="wrap detail"><nav class="breadcrumbs" aria-label="Đường dẫn"><a href="/">Trang chủ</a><span>/</span><a href={`/mon/${dish.slug}/`}>{dish.name}</a><span>/</span><span aria-current="page">{restaurant.name}</span></nav><div class="detail-heading"><p class="eyebrow">ĐỊA CHỈ GỢI Ý / ĐÀ LẠT</p><h1>{restaurant.name}<span class="brand-dot">.</span></h1><p class="lead">Một điểm dừng để bạn tìm hiểu thêm.</p></div><div class="detail-grid"><div><FoodImage src={dish.image} name={dish.name} eager/><p class="small">Ảnh minh họa món {dish.name.toLowerCase()}, không phải ảnh được chụp tại {restaurant.name}.</p></div><section class="practical-panel" aria-labelledby="practical-title"><p class="eyebrow">THÔNG TIN THỰC TẾ</p><h2 id="practical-title">Trước khi ghé quán</h2><dl><div><dt>Địa chỉ được cung cấp</dt><dd>{restaurant.address}, Đà Lạt</dd></div><div><dt>Số nhà</dt><dd>{restaurant.houseNumber??'Chưa có thông tin — cần xác minh địa chỉ cụ thể'}</dd></div><div><dt>Món gợi ý</dt><dd><a href={`/mon/${dish.slug}/`}>{dish.name} ↗</a></dd></div><div><dt>Giờ mở cửa</dt><dd>Chưa có thông tin xác minh</dd></div><div><dt>Giá tham khảo</dt><dd>Chưa có thông tin xác minh</dd></div></dl><a class="button" href={mapsSearchUrl(restaurant)} target="_blank" rel="noopener noreferrer">Tìm trên Google Maps <span aria-hidden="true">↗</span><span class="sr-only"> (mở tab mới)</span></a><p class="small">Tìm kiếm theo tên + địa chỉ. Không phải vị trí ghim đã xác minh. Kiểm tra đúng quán, địa chỉ và giờ phục vụ trước khi di chuyển.</p><Provenance/></section></div><section class="plain-note"><h2>Một ghi chú minh bạch</h2><p>Địa chỉ này do người dùng cung cấp. Chưa có khảo sát tại quán hoặc đánh giá biên tập về món ăn, không gian hay dịch vụ. Thông tin có thể thay đổi; bạn nên xác nhận trực tiếp trước khi ghé.</p></section></div></Layout>
