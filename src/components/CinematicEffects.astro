<script>
const motion = matchMedia('(prefers-reduced-motion: reduce)');
const finePointer = matchMedia('(hover: hover) and (pointer: fine)');
const surfaces = document.querySelectorAll<HTMLElement>('[data-tilt]');
for (const surface of surfaces) {
 let frame = 0;
 surface.addEventListener('pointermove', (event) => {
  if (motion.matches || !finePointer.matches) return;
  cancelAnimationFrame(frame);
  frame = requestAnimationFrame(() => {
   const box = surface.getBoundingClientRect();
   const x = (event.clientX - box.left) / box.width - .5;
   const y = (event.clientY - box.top) / box.height - .5;
   surface.style.setProperty('--rx', `${-y * 9}deg`);
   surface.style.setProperty('--ry', `${x * 12}deg`);
   surface.style.setProperty('--light-x', `${(x + .5) * 100}%`);
   surface.style.setProperty('--light-y', `${(y + .5) * 100}%`);
  });
 });
 const reset = () => { cancelAnimationFrame(frame); surface.style.removeProperty('--rx'); surface.style.removeProperty('--ry'); };
 surface.addEventListener('pointerleave', reset);
 motion.addEventListener('change', reset);
}
if (!motion.matches && 'IntersectionObserver' in window) {
 const observer = new IntersectionObserver(entries => {
  for (const entry of entries) if (entry.isIntersecting) {
   entry.target.classList.add('scene-entered'); observer.unobserve(entry.target);
  }
 }, {threshold: .12});
 document.querySelectorAll('.dish-card, .editorial-note').forEach(el => observer.observe(el));
}
</script>
